config_version=5
[application]
config/name="AFTERIMAGE — The Last Room"
config/description="A psychological FPS about the orders we keep obeying."
config/version="0.9.1-beta"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"
[autoload]
GameState="*res://scripts/game_state.gd"
Sound="*res://scripts/sound.gd"
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.025, 0.03, 0.045, 1)
